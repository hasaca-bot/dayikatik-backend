# Set these in the process environment (this file is not loaded automatically).
# At least 16 characters; generate a unique random password before deployment.
ADMIN_PASSWORD=
# New key pair, generated with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Only trusted reverse proxy CIDRs/addresses. Leave empty when directly exposed.
TRUST_PROXY=
# Extra exact frontend origins, comma separated; no wildcard subdomains.
CORS_ORIGINS=
